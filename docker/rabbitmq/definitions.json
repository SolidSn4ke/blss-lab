{
    "vhosts": [
        {
            "name": "/"
        }
    ],
    "users": [
        {
            "name": "admin",
            "password": "admin",
            "tags": "administrator"
        }
    ],
    "permissions": [
        {
            "user": "admin",
            "vhost": "/",
            "configure": ".*",
            "write": ".*",
            "read": ".*"
        }
    ],
    "queues": [
        {
            "name": "testTopic.queue",
            "vhost": "/",
            "durable": true,
            "auto_delete": false,
            "arguments": {}
        }
    ],
    "bindings": [
        {
            "source": "amq.topic",
            "vhost": "/",
            "destination": "testTopic.queue",
            "destination_type": "queue",
            "routing_key": "testTopic",
            "arguments": {}
        }
    ]
}